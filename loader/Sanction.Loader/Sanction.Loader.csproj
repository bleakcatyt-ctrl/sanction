<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sanction Loader — .NET 8 WinForms, zero NuGet dependencies.
    Everything (ECDH, HKDF, AES-GCM, ECDSA) comes from System.Security.Cryptography,
    so the published exe is small and reproducible.

    Build:  see loader/README.md  (or run loader/build.cmd on Windows)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>Sanction.Loader</RootNamespace>
    <AssemblyName>Sanction.Loader</AssemblyName>
    <AssemblyTitle>Sanction</AssemblyTitle>
    <Product>Sanction</Product>
    <Company>Sanction</Company>
    <Copyright>Sanction</Copyright>

    <!-- Must stay in sync with config.build.latestVersion on the server. -->
    <Version>1.0.4</Version>
    <FileVersion>1.0.4.0</FileVersion>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Lets `dotnet build` produce the Windows exe from Linux/macOS too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build output is regenerated by tools/embed-loader-config.mjs -->
    <Compile Update="Core\BuildConfig.g.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
  </ItemGroup>

</Project>
