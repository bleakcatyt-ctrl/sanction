<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof code !== 'undefined' ? code : 'Ошибка' %> — SANCTION</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='%2338bdf8' d='M12 2.2l8.4 3.6v6.1c0 5-3.5 9.3-8.4 10.9-4.9-1.6-8.4-5.9-8.4-10.9V5.8L12 2.2z'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<div class="bg"></div>
<div class="bg-noise"></div>
<div class="bg-orb a"></div>

<main class="auth-shell">
  <div class="wrap-xs">
    <div class="panel auth-card ticks" style="text-align:center">
      <div class="logo-row">
        <div class="auth-lock" style="background:rgba(251,113,133,.1);border-color:rgba(251,113,133,.28);color:#fda4af"><%- icon('alert') %></div>
        <div>
          <h1><%= typeof code !== 'undefined' ? code : 'Ошибка' %></h1>
          <p class="sub"><%= typeof message !== 'undefined' ? message : 'Что-то пошло не так.' %></p>
        </div>
      </div>

      <div class="code" style="text-align:left;margin-bottom:20px">
<span class="c">// что можно сделать</span>
<span class="k">01</span>  вернуться на главную и попробовать снова
<span class="k">02</span>  проверить, что вы вошли в аккаунт
<span class="k">03</span>  написать в поддержку, если ошибка повторяется</div>

      <div class="row" style="gap:9px;justify-content:center;flex-wrap:wrap">
        <a href="/" class="btn btn-primary"><%- icon('arrowRight') %> На главную</a>
        <a href="/status" class="btn btn-ghost"><%- icon('activity') %> Статус сервиса</a>
      </div>
    </div>
  </div>
</main>
</body>
</html>
