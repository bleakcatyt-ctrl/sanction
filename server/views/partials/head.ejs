<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' && title ? title + ' — ' + site.title : site.title %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : site.title + ' — лицензирование, выдача ключей и синхронизация с лоадером. Подписки 30, 90 и 180 дней.' %>">
<meta name="theme-color" content="#04070e">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%234d8dff'/%3E%3Cstop offset='1' stop-color='%2322d3ee'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath fill='url(%23g)' d='M12 2.2l8.4 3.6v6.1c0 5-3.5 9.3-8.4 10.9-4.9-1.6-8.4-5.9-8.4-10.9V5.8L12 2.2z'/%3E%3Cpath fill='%2304121f' d='M7.6 12.2h2.6l1.1-2.4 1.8 4.8 1.3-2.4h2.2v-1.4h-3l-1.1 2.1-1.8-4.8-1.5 3.1H7.6z'/%3E%3C/svg%3E">
<link rel="preconnect" href="/" crossorigin>
<link rel="stylesheet" href="/static/css/app.css">
<link rel="manifest" href="/static/site.webmanifest">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<div class="bg"></div>
<div class="bg-noise"></div>
<div class="bg-orb a"></div>
<div class="bg-orb b"></div>
<script nonce="<%= nonce %>">window.SNC = { csrf: "<%= csrf %>", user: <%- user ? JSON.stringify(user) : 'null' %>, site: <%- JSON.stringify({ title: site.title, status: site.status }) %> };</script>
