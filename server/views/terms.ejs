<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="section-tight" style="padding-top:48px">
  <div class="wrap-sm">
    <div class="sec-hd reveal" style="margin-bottom:26px">
      <span class="eyebrow"><%- icon('file') %> Документ</span>
      <h2>Условия использования</h2>
      <p>Коротко и по делу: что вы покупаете, как долго это работает и в каких случаях доступ прекращается.</p>
    </div>

    <div class="panel ticks reveal" style="padding:30px 34px">
      <% const sections = [
        ['1. Предмет', 'Вы приобретаете ограниченную по сроку лицензию на использование клиентского приложения. Лицензия выдаётся на 30, 90 или 180 дней в зависимости от выбранного тарифа и действует до указанной в личном кабинете даты.'],
        ['2. Выдача доступа', 'Доступ выдаётся автоматически после подтверждения платежа платёжным шлюзом. Одновременно создаются лицензионный ключ и отдельная пара логин/пароль для клиента. Они отображаются в личном кабинете и хранятся в единой базе, к которой обращается клиент.'],
        ['3. Начало срока', 'По умолчанию отсчёт начинается с первой успешной авторизации клиента. Если срок уже начался, продление добавляет дни к текущему остатку, а не заменяет его.'],
        ['4. Привязка к устройству', 'Лицензия действует на одном устройстве. Идентификатор оборудования фиксируется при первом входе. Количество сбросов привязки определяется тарифом, между сбросами действует период ожидания 72 часа.'],
        ['5. Прекращение доступа', 'По истечении срока лицензия переводится в статус «истекла»: клиент теряет доступ при ближайшей проверке, загрузка сборок закрывается. Продление после истечения запускает новый срок с момента оплаты.'],
        ['6. Запрещённые действия', 'Запрещены передача доступа третьим лицам, продажа или публикация учётных данных, попытки модификации клиента, обхода проверки лицензии, подделки ответов сервера и извлечения закрытых компонентов. Такие действия ведут к отзыву лицензии без возврата средств.'],
        ['7. Возвраты', 'Оплаченная и активированная лицензия возврату не подлежит, поскольку доступ предоставляется немедленно. Возврат возможен до первой активации по решению администрации.'],
        ['8. Доступность сервиса', 'Сервис предоставляется «как есть». Администрация может приостанавливать работу для обновлений, а также отключать устаревшие сборки клиента. Актуальное состояние публикуется на странице статуса.'],
        ['9. Данные', 'Хранятся минимум данных, необходимых для работы: учётная запись, заказы, лицензии, идентификаторы оборудования и журнал событий безопасности. Переписка и платёжные реквизиты карт на сервере не хранятся — их обрабатывает платёжный шлюз.'],
        ['10. Изменения', 'Условия могут обновляться. Действующая редакция всегда доступна на этой странице, дата изменения указывается внизу.']
      ] %>
      <% sections.forEach(function (s) { %>
        <div style="margin-bottom:22px">
          <h3 style="font-size:14.6px;font-weight:640;color:var(--ice)"><%= s[0] %></h3>
          <p class="muted" style="font-size:13.6px;line-height:1.72;margin-top:7px"><%= s[1] %></p>
        </div>
      <% }) %>
      <div class="divider"></div>
      <p class="dim" style="font-size:12px">Редакция от <%= util.formatDate(new Date('2026-01-01').getTime()) %> · <%= site.title %></p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
