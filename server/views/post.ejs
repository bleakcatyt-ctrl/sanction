<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="section-tight" style="padding-top:48px">
  <div class="wrap-sm">
    <a href="/news" class="btn btn-quiet btn-sm" style="margin-bottom:20px"><%- icon('chevronRight') %> Все записи</a>

    <article class="panel ticks reveal" style="padding:36px 38px">
      <div class="row" style="gap:10px">
        <span class="chip chip-info"><%= post.tag %></span>
        <span class="mono dim" style="font-size:11px"><%= util.formatDate(post.created_at) %></span>
      </div>
      <h1 style="font-size:clamp(24px,3.6vw,34px);margin-top:16px;letter-spacing:-.038em"><%= post.title %></h1>
      <div style="margin-top:20px;font-size:15px;line-height:1.78;color:var(--text-2)">
        <% post.body.split('\n').filter(Boolean).forEach(function (para) { %>
          <p style="margin-bottom:14px"><%= para %></p>
        <% }) %>
      </div>
    </article>

    <div class="row-between" style="margin-top:24px;flex-wrap:wrap;gap:12px">
      <a href="/pricing" class="btn btn-ghost btn-sm"><%- icon('ticket') %> Тарифы</a>
      <a href="/status" class="btn btn-ghost btn-sm"><%- icon('activity') %> Статус сервиса</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
